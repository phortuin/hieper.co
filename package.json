{
  "name": "dropbox-markdown-ssg",
  "version": "1.0.0",
  "description": "Static site generator for Markdown files stored on Dropbox",
  "keywords": [
    "markdown",
    "md",
    "dropbox",
    "cms",
    "static",
    "flat-file"
  ],
  "license": "MIT",
  "homepage": "https://github.com/phortuin/dropbox-markdown-ssg",
  "author": {
    "name": "Anne Fortuin",
    "url": "phortuin.nl"
  },
  "repository": "phortuin/dropbox-markdown-ssg",
  "engines": {
    "node": ">=6"
  },
  "scripts": {
    "prebuild": "rimraf dist && mkdirp dist/client",
    "build": "run-s build:*",
    "build:assets": "ncp src/client/assets dist/client",
    "build:pages": "./scripts/build-pages.js -d dist/client",
    "build:server": "netlify-lambda build src/server",
    "dev": "run-p dev:*",
    "dev:client": "serve dist/client",
    "dev:server": "netlify-lambda serve src/server",
    "dev:watch": "run-p watch:*",
    "test": "tape test.js",
    "watch:css": "chokidar 'src/client/assets/*' --command 'npm run build:assets'",
    "watch:pages": "chokidar 'src/client/templates/*.html' --command 'npm run build:pages'"
  },
  "devDependencies": {
    "chokidar-cli": "1.2.2",
    "netlify-lambda": "1.4.3",
    "serve": "11.0.0",
    "tape": "4.10.1"
  },
  "dependencies": {
    "bluebird": "3.5.4",
    "dotenv": "7.0.0",
    "dotenv-safe": "6.1.0",
    "dropbox": "4.0.17",
    "got": "9.6.0",
    "markdown-description": "1.1.0",
    "markdown-title": "1.0.2",
    "marked": "0.6.2",
    "mkdirp": "0.5.1",
    "ncp": "2.0.0",
    "node-fetch": "2.3.0",
    "npm-run-all": "4.1.5",
    "nunjucks": "3.2.0",
    "prismjs": "1.16.0",
    "rimraf": "2.6.3",
    "yargs": "13.2.2"
  }
}
