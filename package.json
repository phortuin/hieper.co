{
  "name": "hieper.co",
  "version": "1.1.0",
  "description": "Hieper.co: statically generated site from Markdown files stored on Dropbox",
  "license": "MIT",
  "homepage": "https://github.com/phortuin/hieper.co",
  "author": {
    "name": "Anne Fortuin",
    "url": "phortuin.nl"
  },
  "repository": "phortuin/hieper.co",
  "engines": {
    "node": ">=6"
  },
  "scripts": {
    "prebuild": "rimraf dist && mkdirp dist",
    "build": "run-s build:*",
    "build:assets": "ncp src/assets dist",
    "build:pages": "./scripts/build-pages.js --dest dist",
    "deploy": "./scripts/deploy-to-s3.js --source dist --bucket hieper.co",
    "dev": "run-p dev:*",
    "dev:client": "serve dist",
    "dev:watch": "run-p watch:*",
    "test": "tape test.js",
    "watch:css": "chokidar 'src/assets/*' --command 'npm run build:assets'",
    "watch:pages": "chokidar 'src/templates/*.html' --command 'npm run build:pages'"
  },
  "devDependencies": {
    "aws-sdk": "2.517.0",
    "bluebird": "3.5.4",
    "chokidar-cli": "2.0.0",
    "dotenv": "7.0.0",
    "dotenv-safe": "6.1.0",
    "dropbox": "4.0.17",
    "globby": "10.0.1",
    "got": "9.6.0",
    "markdown-description": "1.1.0",
    "markdown-title": "1.0.2",
    "marked": "0.7.0",
    "mime": "2.4.4",
    "mkdirp": "0.5.1",
    "ncp": "2.0.0",
    "node-fetch": "2.3.0",
    "npm-run-all": "4.1.5",
    "nunjucks": "3.2.0",
    "prismjs": "1.16.0",
    "rimraf": "2.6.3",
    "serve": "11.0.0",
    "tape": "4.10.1",
    "yargs": "13.2.2"
  }
}
